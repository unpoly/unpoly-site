<%#
  The site's search, as one popup reachable from every page.

  It is empty until it opens: the sidecar of symbol names and the full-text index are
  both fetched on the first open, so a reader who never searches pays nothing for it.

  Triggers live in source/javascripts/components/search_popup.js — the header pill, the
  drawer's button and the "/" key all open this same element. Without JavaScript none of
  them do anything and the pill stays what it is in the markup: a link to the reference.
%>
<div class="search-popup" hidden data-pagefind-ignore>
  <div class="search-popup--backdrop"></div>

  <div class="search-popup--window" role="dialog" aria-modal="true" aria-label="Search the documentation">
    <div class="search-popup--head">
      <i class="fa fa-search search-popup--icon" aria-hidden="true"></i>
      <input type="text"
             class="search-popup--input"
             placeholder="Search docs…"
             aria-label="Search docs"
             role="combobox"
             aria-expanded="false"
             aria-controls="search-popup-results"
             aria-autocomplete="list"
             autocomplete="off"
             spellcheck="false">
      <button type="button" class="search-popup--close" aria-label="Close search">&times;</button>
    </div>

    <div class="search-popup--results" id="search-popup-results" role="listbox" aria-label="Search results"></div>

    <div class="search-popup--foot">
      <span class="search-popup--hint"><kbd>↑↓</kbd> navigate</span>
      <span class="search-popup--hint"><kbd>↵</kbd> open</span>
      <span class="search-popup--hint"><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>
