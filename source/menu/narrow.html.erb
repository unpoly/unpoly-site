<% menu do %>
  <div class="menu--nodes">
    <!--  <div class="node">-->
    <%#= node_link 'API', '/api' %>
    <!--  </div>-->

    <div class="node">
      <%= node_link 'Demo', 'https://demo.unpoly.com' %>
    </div>

    <div class="node">
      <%= node_link 'Installation', '/install' %>
    </div>

    <div class="node">
      <%= node_link 'Support', '/support' %>
    </div>

    <% guide.toc.areas.each do |area| %>
      <div class="node -group">
        <span class="node--self">
          <span class="node--title"><%= area.title %></span>
        </span>
      </div>

      <% area.topics.each do |topic| %>
        <%= partial 'nodes/node', locals: { node: topic } %>
      <% end %>
    <% end %>

    <div class="node">
      <%= node_link 'Changes', '/changes' %>
    </div>

  </div>
<% end %>
