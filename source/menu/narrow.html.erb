<% menu do %>
  <%# On a narrow screen the burger is the only way in, so the drawer carries the search.
      The header pill is hidden at this width, and this opens the same popup it does. %>
  <div class="menu--search">
    <button type="button" class="search-trigger">
      <i class="fa fa-search search-trigger--icon" aria-hidden="true"></i>
      Search docs…
    </button>
  </div>

  <div class="menu--nodes">
    <!--  <div class="node">-->
    <%#= node_link 'API', '/api' %>
    <!--  </div>-->

    <div class="node">
      <%= node_link 'Demo', 'https://demo.unpoly.com' %>
    </div>

    <div class="node">
      <%= node_link 'Installation', '/install' %>
    </div>

    <div class="node">
      <%= node_link 'Support', '/support' %>
    </div>

    <% guide.toc.areas.each do |area| %>
      <div class="node -group">
        <span class="node--self">
          <span class="node--title"><%= area.title %></span>
        </span>
      </div>

      <% area.topics.each do |topic| %>
        <%= partial 'nodes/node', locals: { node: topic } %>
      <% end %>
    <% end %>

    <div class="node">
      <%= node_link 'Changes', '/changes' %>
    </div>

  </div>

  <div class="content-search" data-algolia-index="<%= algolia_index %>"></div>
<% end %>
