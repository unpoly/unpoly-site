<form class="search" action="#">
  <%# No autofocus: the menu loads lazily, so it steals focus mid-read — and a focused
      field takes the "/" shortcut away from the search popup, which now owns that key. %>
  <input type="text" class="search--input" placeholder="Search …" id="search" autocomplete="off">
  <i class="search--icon fa fa-search"></i>
  <span class="search--reset">&times;</span>
  <div class="search--expand-help content-search--related">
    <span class="search--expand-key">⏎ ENTER</span> Full text search
  </div>
</form>
