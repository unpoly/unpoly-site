<%
  guide.reload if development?
  interface = guide.find_by_guide_id!(interface_id)
  @page_title = interface.title
  area = guide.toc.area_for(interface)
  @menu_path = area.menu_path
  @search_documentable = interface
%>

<%= ai_tools %>

<h1>
  <%= breadcrumb_link area.title, area.path %>

  <% if interface.module? %>
    <%= interface.title %>
    <div class="subtitle" data-pagefind-ignore data-markdown="chip">
      <span class="dimmed">module</span>
      <%= interface.name %>
    </div>
  <% elsif interface.class? %>
    <span class="dimmed">class</span>
    <%= interface.title %>
  <% elsif interface.page? %>
    <%= interface.title %>
  <% end %>
</h1>

<% auto_toc do %>

  <% if interface.guide_markdown.present? %>
    <%= documented_prose(interface) %>
  <% end %>

  <%
    essential_features = interface.essential_features
    all_features = interface.guide_features.sort
  %>

  <% if essential_features.present? || all_features.present? %>

    <hr class="separator">

    <% if essential_features.present? || all_features.present? %>

      <h2 id="features">Features</h2>

      <% if essential_features.present? %>
        <h3 id="essential-features">Essentials</h3>

        <%# Each card is a list item with a heading, its link only on the signature, so
            screen readers and the Markdown twin read a list of named features. [up-expand]
            keeps the whole card clickable. The kind badge follows the signature inside the
            heading; CSS draws it in the card's corner. %>
        <ul class="essential-features">
          <% essential_features.each do |feature| %>
            <li class="essential-feature <%= '-code' if feature.code? %>" up-expand>
              <div class="essential-feature--title" role="heading" aria-level="4">
                <a class="essential-feature--signature" href="<%= feature.guide_path %>"><%= feature.short_signature %></a>
                <span class="essential-feature--kind" title="<%= feature.long_kind %>" data-markdown="chip"><%= feature.short_kind %></span>
              </div>
              <div class="essential-feature--summary">
                <%= markdown_prose(feature.summary_markdown, strip_links: true) %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if all_features.present? %>
        <h3 id="all-features">All features</h3>

        <ul>
          <% all_features.each do |feature| %>
            <%= feature_preview(feature) %>
          <% end %>
        </ul>
      <% end %>

    <% end %>

  <% end %>
<% end %>

<% topic = guide.toc.topic_of(interface) %>
<%# Only chapter overviews: a module page lists every feature already, under "All features". %>
<% if interface.page? && topic && topic.start_page == interface %>
  <%= partial 'children_index', locals: { topic: topic } %>
<% end %>

<%= partial 'reading_nav', locals: { area: area, documentable: interface } %>
