<%
  guide.reload if development?
  interface = guide.find_by_guide_id!(interface_id)
  @page_title = interface.title
  area = guide.toc.area_for(interface)
  @menu_path = area.menu_path
  @search_documentable = interface
%>

<% page_title interface.title do %>
  <%= breadcrumb_link area.title, area.path %>

  <% if interface.page? %>
    <%= interface.title %>
  <% else %>
    <%# A module or class is titled by its JavaScript name, like a feature by its signature. %>
    <code class="-name"><%= breakable_signature(interface.name) %></code>
    <div class="subtitle" data-pagefind-ignore data-markdown="chip">
      <%= interface.kind %>
    </div>
  <% end %>
<% end %>

<% auto_toc do %>

  <% if interface.guide_markdown.present? %>
    <%= documented_prose(interface) %>
  <% end %>

  <% all_features = interface.guide_features.sort %>

  <% if all_features.present? %>

    <hr class="separator">

    <h2 id="features">Features</h2>

    <ul>
      <% all_features.each do |feature| %>
        <%= feature_preview(feature) %>
      <% end %>
    </ul>

  <% end %>
<% end %>

<% topic = guide.toc.topic_of(interface) %>
<%# Only chapter overviews: a module page lists every feature already, under "Features". %>
<% if interface.page? && topic && topic.start_page == interface %>
  <%= partial 'children_index', locals: { topic: topic } %>
<% end %>

<%= partial 'reading_nav', locals: { area: area, documentable: interface } %>
