<%#
  The API hub: a catalog to look things up in. One row per topic of the API sidebar, in
  the sidebar's order. A module row names the module (the link to its page), its
  summary, and up to six of its signature features (the ones marked @signature, which
  search also ranks first) with a count of the rest. A page group (Formats) lists its
  pages instead.

  The count is of what the module page lists under All features: its features with a
  page of their own. Classes like up.Layer have sidebar rows but are not counted. A
  module with no signature features shows its whole count, without a plus.

  Names, summaries and features come from the model. The intro below the title is the
  hub's own copy.
%>
<% area = guide.toc.api %>
<% @menu_path = area.menu_path %>
<% shown_features = 6 %>

<h1><%= page_title area.title %></h1>

<p class="hub-intro">
  Technical reference for every attribute, function, event and HTTP header in Unpoly.<br>
  For concepts and walkthroughs, see <a href="/learn" class="hub-link">Learn</a>.
</p>

<div class="api-catalog">
  <% area.topics.each do |topic| %>
    <% interface = topic.try(:interface) %>
    <%
      if interface
        all_features = interface.guide_features
        links = topic.children.flat_map(&:children).select { |feature| feature.signature_tier? && all_features.include?(feature) }.first(shown_features)
        more = all_features.size - links.size
      else
        links = topic.pages
        more = 0
      end
    %>

    <div class="api-row<%= ' -module' if interface %>">
      <a href="<%= topic.menu_path %>" class="api-row--name">
        <% if interface %>
          <svg class="api-row--icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
        <% else %>
          <svg class="api-row--icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1"/></svg>
        <% end %>
        <span class="api-row--title"><%= topic.title %></span><span class="hub-topic--chevron" aria-hidden="true">›</span>
      </a>

      <div class="api-row--body">
        <% if topic.summary_markdown.present? %>
          <div class="api-row--summary"><%= markdown(topic.summary_markdown, strip_links: true) %></div>
        <% end %>

        <% if links.any? || more > 0 %>
          <ul class="api-row--features">
            <% links.each do |documentable| %>
              <li><%= link_to breakable_signature(documentable.menu_title), documentable.guide_path, class: 'api-row--feature' %></li>
            <% end %>
            <% if more > 0 %>
              <li><a href="<%= topic.menu_path %>#all-features" class="api-row--more"><%= links.any? ? "+ #{more} more" : pluralize(more, 'feature', 'features') %></a></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
