<%# A list item of the "All features" list (see the cards in interface_template.html.erb). %>
<li class="documentable-preview -<%= feature.visibility %>" up-expand>

  <div class="documentable-preview--title" role="heading" aria-level="4">
    <a href="<%= feature.guide_path %>" class="documentable-preview--signature"><%= h(feature.signature) %></a>
    <%# A screen reader says the long kind, as does the Markdown twin (from the title). %>
    <span class="documentable-preview--kind -<%= feature.short_kind.downcase %>" role="img" aria-label="<%= feature.long_kind %>" title="<%= feature.long_kind %>" data-markdown="chip">
      <%= icon("kind-#{feature.short_kind.downcase}") %>
      <span class="documentable-preview--kind-label"><%= feature.short_kind %></span>
    </span>
    <% unless feature.stable? %>
      <span class="documentable-preview--visibility"><%= visibility_tag(feature.visibility) %></span>
    <% end %>
  </div>

  <% if feature.summary_markdown.present? %>
    <div class="documentable-preview--summary">
      <%= markdown_prose(feature.summary_markdown, strip_links: true) %>
    </div>
  <% end %>

</li>
