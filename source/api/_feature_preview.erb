<a href="<%= feature.guide_path %>" class="documentable-preview -<%= feature.visibility %>">

  <span class="documentable-preview--kind" title="<%= feature.long_kind %>"><%= feature.short_kind %></span>

  <div class="documentable-preview--title">
    <span class="documentable-preview--signature"><%= h(feature.signature) %></span>
    <span class="documentable-preview--visibility"><%= visibility_tag(feature.visibility) %></span>
  </div>

  <% if feature.summary_markdown.present? %>
    <div class="documentable-preview--summary">
      <%= markdown_prose(feature.summary_markdown, strip_links: true) %>
    </div>
  <% end %>

</a>
