DirectorySlash Off
Options -Indexes

RewriteEngine On

# www.unpoly.com/foo to unpoly.com/foo, for good.
#
# v3 is the current version, so v3.unpoly.com/foo also goes to unpoly.com/foo, but
# only temporarily (307): once Unpoly 4 is out, v3.unpoly.com serves the v3 docs again,
# and browsers would keep following a cached 301.
#
# These come first: below, /foo is rewritten to /foo/index.html, which a later rule
# would put into the redirect (www.unpoly.com/up.render went to /up.render/index.html).
RewriteCond %{HTTP_HOST} ^www\.unpoly\.com$
RewriteRule ^(.*)$ https://unpoly.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^v3\.unpoly\.com$
RewriteRule ^(.*)$ https://unpoly.com/$1 [R=307,L]

# /foo/ to /foo. The target names its scheme: Apache sits behind a proxy that ends
# TLS, so it sees plain http and would build an http:// Location from a bare path.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# Markdown for agents: every documentation page has a twin at its URL plus .md
# (/up.render.md), and /index.md (= /llms.txt) stands in for the landing page.
AddType "text/markdown; charset=utf-8" .md

# The skill index for `npx skills add https://unpoly.com`. The deploy archives the build
# without dot-directories, so its files are built into /agent-skills.
RewriteRule ^\.well-known/agent-skills/(.*)$ /agent-skills/$1 [L]

# An agent that names text/markdown as its FIRST choice gets the twin at the page's own
# URL. Browsers, curl and agents that send */* keep getting HTML; so does a Markdown
# preference given as q=0. Vary (below) keeps caches from mixing the two.
RewriteCond %{HTTP:Accept} ^\s*text/markdown(?![^,]*;\s*q=0(\.0*)?\s*(,|$))\s*(,|;|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^(.+)$ /$1.md [L]

RewriteCond %{HTTP:Accept} ^\s*text/markdown(?![^,]*;\s*q=0(\.0*)?\s*(,|$))\s*(,|;|$) [NC]
RewriteRule ^$ /index.md [L]

# Short paths: /foo redirects to /learn/foo if that page exists, else to /api/foo.
# Documents lived at the root until the docs rework 2026 (/caching, /up.render), so
# this keeps every old document URL alive, and works as a shortcut for future pages.
# /install and /skill are printed on slides and in talks: keep this rule forever.
#
# - A page exists when its directory has an index.html. Testing the directory alone
#   (-d) would also match /learn/start, which only holds pages below it.
# - A page or file at the root itself (/api, /changes, /api.md) wins.
# - Learn wins over API. A slug used by both fails the build (Toc), so this
#   never decides anything.
# - The renames below (RedirectPermanent) run after all RewriteRules, wherever they
#   stand in this file: Apache applies an .htaccess's mod_rewrite before its mod_alias.
#   So no rename may start at a path that this rule redirects (rake docs:check_urls
#   and script/url_move.rb fail on one).
# - Needs %{DOCUMENT_ROOT} to be the build directory, like the rules above.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/learn/$1/index.html -f
RewriteRule ^(.+?)/?$ https://%{HTTP_HOST}/learn/$1 [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/api/$1/index.html -f
RewriteRule ^(.+?)/?$ https://%{HTTP_HOST}/api/$1 [R=301,L]

# The same for Markdown twins: /caching.md to /learn/caching.md.
RewriteCond %{DOCUMENT_ROOT}/$1.md !-f
RewriteCond %{DOCUMENT_ROOT}/learn/$1.md -f
RewriteRule ^(.+)\.md$ https://%{HTTP_HOST}/learn/$1.md [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/$1.md !-f
RewriteCond %{DOCUMENT_ROOT}/api/$1.md -f
RewriteRule ^(.+)\.md$ https://%{HTTP_HOST}/api/$1.md [R=301,L]

# No .md URL existed before the twins. So a .md URL without a file is a page that has
# been renamed: send it to the page, where the rename's redirect (below) takes over.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.md$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)$  /$1/index.html [L]

RedirectPermanent /install/rails /learn/server-protocol
RedirectPermanent /install/ruby /learn/server-protocol
RedirectPermanent /install/php /learn/server-protocol
RedirectPermanent /install/elixir /learn/server-protocol
RedirectPermanent /install/rust /learn/server-protocol
RedirectPermanent /install/npm /learn/install#npm
RedirectPermanent /install/zip /learn/install
RedirectPermanent /install/cdn /learn/install
RedirectPermanent /install/download /learn/install

RedirectPermanent /install/protocol /learn/server-protocol
RedirectPermanent /install/server-protocol /learn/server-protocol

RedirectPermanent /community /support
RedirectPermanent /discuss https://github.com/unpoly/unpoly/discussions
RedirectPermanent /discussion https://github.com/unpoly/unpoly/discussions
RedirectPermanent /discussions https://github.com/unpoly/unpoly/discussions
RedirectPermanent /talk https://github.com/unpoly/unpoly/discussions
RedirectPermanent /forum https://github.com/unpoly/unpoly/discussions

<%= guide.migrate_redirects %>

Header set Cache-Control "max-age=0, private"

# A page's URL serves HTML or Markdown depending on Accept (see the twins above).
# merge keeps an existing Vary: Accept-Encoding.
Header merge Vary Accept "expr=%{CONTENT_TYPE} =~ m#^text/(html|markdown)#"

# The Markdown twins should not compete with their pages in search engines.
<FilesMatch "\.md$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>

<FilesMatch "\.(css|jpg|jpeg|png|svg|gif|js|ico)$">
  Header set Cache-Control "max-age=2628000, public"
</FilesMatch>

# Documentation images and videos keep their names across deploys (no :asset_hash, see
# config.rb), so a changed screenshot must not stay cached for a month. Apache merges
# <If> after <FilesMatch>, so this wins over the rule above for these paths only.
<If "%{REQUEST_URI} =~ m#^/images/(api|changes)/#">
  Header set Cache-Control "max-age=86400, public"
</If>

# Exclude crawlers from hostnames like:
# - v1.unpoly.com
# - v2.unpoly.com
# - pre.unpoly.com
RewriteCond %{HTTP_HOST} ^(v\d+|pre)\.unpoly\.com$
RewriteRule ^robots\.txt$ /robots.exclude.txt [L]

