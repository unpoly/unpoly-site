---
# The sidebar loads this menu into Learn pages ([up-defer]). It is no page of its own:
# search engines may follow its links, but should not list it (indexable? in config.rb).
noindex: true
---
<% menu do %>
  <div class="menu--nodes">
    <% guide.toc.learn.topics.each do |topic| %>
      <%= partial 'nodes/node', locals: { node: topic } %>
    <% end %>
  </div>
<% end %>
