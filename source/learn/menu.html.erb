<% menu do %>
  <div class="menu--search">
    <%= partial 'api/search' %> <%# must be part of .menu because that is loaded lazily %>
  </div>

  <div class="menu--nodes">
    <% guide.toc.learn.topics.each do |topic| %>
      <%= partial 'nodes/node', locals: { node: topic } %>
    <% end %>
  </div>

  <div class="content-search" data-algolia-index="<%= algolia_index %>"></div>
<% end %>
