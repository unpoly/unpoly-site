<%#
  The Learn hub: a way into the course and an index of all of it. Getting started
  stands on its own as the place to begin; the chapters follow as a numbered path, each
  with its overview and all of its pages. Below $bp-sidebar there is no sidebar, so this
  page is the only place that shows the whole curriculum at once.

  Titles, blurbs and page lists come from the model (toc.yml and each chapter's
  overview). A summary the overview has not been written for yet is left out rather
  than shown as a placeholder. The intro below the title is the hub's own copy.
%>
<% area = guide.toc.learn %>
<% @menu_path = area.menu_path %>
<% start, *chapters = area.topics %>
<% blurb = ->(topic) { text = topic.summary_markdown.to_s.strip; text unless text.blank? || text == 'This page is being written.' } %>

<%= ai_tools %>

<h1><%= page_title 'Learn Unpoly' %></h1>

<p class="hub-intro">
  Guides that explain how Unpoly works and how to use it.<br>
  Looking up a specific attribute or function? See the <a href="/api" class="hub-link">API reference</a>.
</p>

<section class="learn-start" aria-labelledby="learn-start-title">
  <p class="learn-start--caption">Start here</p>

  <h2 class="learn-start--title" id="learn-start-title">
    <a href="<%= start.menu_path %>" class="hub-topic"><%= start.title %><span class="hub-topic--chevron" aria-hidden="true">›</span></a>
  </h2>

  <% if (text = blurb.(start)) %>
    <div class="learn-start--blurb"><%= markdown(text, strip_links: true) %></div>
  <% end %>

  <%= partial 'learn/chapter_pages', locals: { topic: start, overview_label: start.start_page.title } %>
</section>

<ol class="learn-path">
  <% chapters.each.with_index(1) do |chapter, number| %>
    <li class="learn-chapter">
      <span class="learn-chapter--number" aria-hidden="true"><%= number %></span>

      <div class="learn-chapter--body">
        <h2 class="learn-chapter--title">
          <a href="<%= chapter.menu_path %>" class="hub-topic"><%= chapter.title %><span class="hub-topic--chevron" aria-hidden="true">›</span></a>
        </h2>

        <% if (text = blurb.(chapter)) %>
          <div class="learn-chapter--blurb"><%= markdown(text, strip_links: true) %></div>
        <% end %>

        <%= partial 'learn/chapter_pages', locals: { topic: chapter, overview_label: chapter.start_page.menu_title } %>
      </div>
    </li>
  <% end %>
</ol>
