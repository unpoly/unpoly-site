<%#
  A chapter's pages on the Learn hub: its overview first, then every other page, the
  same ones the sidebar lists.

  Locals: topic (a Learn chapter), overview_label (what to call its overview).
%>
<ul class="chapter-pages">
  <li>
    <a href="<%= topic.menu_path %>" class="chapter-pages--overview">
      <%= icon('overview', class: 'chapter-pages--icon') %>
      <%= overview_label %>
    </a>
  </li>
  <% topic.children.each do |page| %>
    <li><a href="<%= page.guide_path %>" class="hub-link"><%= page.menu_title %></a></li>
  <% end %>
</ul>
