<%#
  Three requests through an Unpoly app: the server answers with full pages, Unpoly
  keeps only the targeted fragments, and rendering less is an optional optimization.

  Drawn inline rather than embedded as an <img>, so the labels are real <text> in
  the site's own webfont and take their colors from the palette.

  The landing renders this partial; a guide embeds it from its Markdown with
  <div embed="fragment-updates-diagram"></div> (Unpoly::Guide::Embeds). Its labels
  stay out of the search index, where they would only be noise in excerpts.
%>
<%
  # One page mockup, drawn as the source image draws it (docs/rework-2026/
  # fragment-updates.png): a contiguous grid of a header bar, a nav column of three
  # cells and a main area, sharing their edges. Every part is filled with its role's
  # tint and outlined in its role's color; a page has no frame of its own, its outline
  # is its parts'. Parts in the base role are drawn first, so a changed part's
  # outline lies on top of the edges it shares.
  #
  # roles: the role of each part, :header, :nav (an array of three) and :main.
  # parts: only these parts (the optimized response leaves the rest out).
  page_mock = lambda do |x:, y:, roles:, parts: nil|
    w, h = 168, 105
    header_h = 19
    nav_w = 41
    cell_h = (h - header_h) / 3.0

    rects = {
      header: [x, y, w, header_h],
      nav0: [x, y + header_h, nav_w, cell_h],
      nav1: [x, y + header_h + cell_h, nav_w, cell_h],
      nav2: [x, y + header_h + 2 * cell_h, nav_w, cell_h],
      main: [x + nav_w, y + header_h, w - nav_w, h - header_h],
    }
    role_of = lambda do |part|
      part.to_s.start_with?('nav') ? roles[:nav][part.to_s[-1].to_i] : roles[part]
    end

    drawn = parts || rects.keys
    drawn = drawn.sort_by { |part| role_of.call(part) == 'base' ? 0 : 1 }
    drawn.map { |part|
      rx, ry, rw, rh = rects[part]
      %(<rect class="diagram--part -#{role_of.call(part)}" x="#{rx}" y="#{ry.round(2)}" width="#{rw}" height="#{rh.round(2)}"/>)
    }.join
  end

  # The roles of a page that shows the base state, with `changed` parts in `role`.
  roles_for = lambda do |role, nav1: false|
    { header: 'base', nav: ['base', nav1 ? role : 'base', 'base'], main: role }
  end

  arrow = lambda do |x:, y:|
    %(<path class="diagram--arrow" d="M#{x - 9} #{y} L#{x + 9} #{y} L#{x} #{y + 11} Z"/>)
  end

  rows = [
    { y: 108, role: 'base',    method: 'GET',   path: '/notes',   note: '(initial load)' },
    { y: 248, role: 'changed', method: 'GET',   path: '/notes/3', note: nil },
    { y: 388, role: 'later',   method: 'PATCH', path: '/notes/3', note: nil },
  ]

  columns = { response: 232, used: 500, optimized: 744 }
%>

<figure class="diagram" data-pagefind-ignore>
  <div class="diagram--scroller">
  <svg class="diagram--canvas" viewBox="0 0 960 512" role="img"
       aria-labelledby="fragment-updates-title fragment-updates-desc">
    <title id="fragment-updates-title">How Unpoly uses a server response</title>
    <desc id="fragment-updates-desc">
      Three requests, each shown across four columns. The server always responds with a
      complete page. Unpoly uses only the fragments that changed, leaving the rest of the
      screen in place. A server may optionally respond with those fragments alone.
    </desc>

    <rect class="diagram--band" x="200" y="0" width="264" height="512"/>
    <rect class="diagram--band" x="712" y="0" width="248" height="512"/>

    <text class="diagram--column" x="24" y="46">BROWSER</text>
    <text class="diagram--column" x="24" y="72">REQUEST</text>
    <text class="diagram--column" x="232" y="46">SERVER</text>
    <text class="diagram--column" x="232" y="72">RESPONSE</text>
    <text class="diagram--column" x="500" y="46">FRAGMENTS</text>
    <text class="diagram--column" x="500" y="72">USED</text>
    <text class="diagram--column" x="744" y="46">OPTIMIZED</text>
    <text class="diagram--column" x="744" y="72">RESPONSE</text>

    <rect class="diagram--badge" x="872" y="14" width="76" height="20" rx="2"/>
    <text class="diagram--badge-text" x="910" y="28" text-anchor="middle">OPTIONAL</text>

    <% rows.each_with_index do |row, index| %>
      <text class="diagram--method" x="24" y="<%= row[:y] + 28 %>"><%= row[:method] %></text>
      <text class="diagram--path" x="24" y="<%= row[:y] + 52 %>"><%= row[:path] %></text>
      <% if row[:note] %>
        <text class="diagram--note" x="24" y="<%= row[:y] + 72 %>"><%= row[:note] %></text>
      <% end %>

      <%# The server always sends a complete page, in the state this request produced. %>
      <%= page_mock.call(x: columns[:response], y: row[:y],
                         roles: { header: row[:role], nav: [row[:role]] * 3, main: row[:role] }) %>

      <%# What the browser ends up showing: the previous screen, with the changed parts swapped in. %>
      <% changed = index.zero? ? roles_for.call('base') : roles_for.call(row[:role], nav1: index == 2) %>
      <%= page_mock.call(x: columns[:used], y: row[:y], roles: changed) %>

      <%# A server may send only the fragments that changed. %>
      <%= page_mock.call(x: columns[:optimized], y: row[:y], roles: changed,
                         parts: (index.zero? ? nil : (index == 2 ? [:nav1, :main] : [:main]))) %>

      <% if index < rows.size - 1 %>
        <% columns.each_value do |x| %>
          <%= arrow.call(x: x + 84, y: row[:y] + 116) %>
        <% end %>
      <% end %>
    <% end %>
  </svg>
  </div>
</figure>
