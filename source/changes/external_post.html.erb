---
layout: false
---
<!doctype html>
<html>
  <head>
    <%= partial 'layouts/meta' %>
  </head>
  <body>
    <% guide.reload if development? %>

<pre>
<%- guide.releases[0..4].each do |release| -%>
<%= release.version %>
<%= '=' * release.version.size %>

<%-
  markdown = autolink_code_in_markdown(release.markdown.gsub(/^###/, '##'))
  # The Markdown is posted elsewhere, so it links to unpoly.com, even when copied from the preview.
  markdown = urlify_paths_in_markdown(markdown, page_path: "/changes/#{release.version}", origin: Unpoly::Site.base_url)
  markdown = github_alerts_in_markdown(markdown)
-%>
<%= h markdown %>

<%- end -%>
</pre>

  </body>
</html>
