<div class="choice">
  <%# The version these docs belong to, marked like a current page. Its link leaves
      this site, so [up-nav] could never find it current. %>
  <a class="choice--item up-current" href="https://unpoly.com" up-follow="false" aria-current="true">Unpoly <%= guide.short_version %></a>
  <% older_versions.each do |label, href| %>
    <a class="choice--item" href="<%= href %>" up-follow="false"><%= label %></a>
  <% end %>
</div>
