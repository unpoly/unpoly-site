<%#
  The path through a linear area: where the reader came from, and where the next page is.
  The next link teases its page title; at a chapter boundary that is the next chapter's
  overview. Lookup areas like the API reference have no reading order and render nothing.
%>
<% if area.linear? %>
  <%
    previous_page = guide.toc.previous_page(documentable)
    next_page = guide.toc.next_page(documentable)
  %>

  <% if previous_page || next_page %>
    <nav class="reading-nav" aria-label="Reading order" data-pagefind-ignore>
      <%= prev_link(previous_page) if previous_page %>
      <%= next_link(next_page) if next_page %>
    </nav>
  <% end %>
<% end %>
