<!doctype html>
<%# The language is declared for screen readers, and because the search indexer picks its
    stemmer from it — without it, a search for "overlays" would not find "overlay". %>
<html lang="en">

  <% guide.ensure_fresh! if development? # reload guide if we have rendered a page with it before %>
  <%= partial 'layouts/head' %>
  <%#
    The frame a page sits in. Every response renders its whole frame inside the torso,
    which is the root layer's main target, so arriving from another page can never leave
    that page's frame behind.

      :docs     a sidebar with the section's menu beside one text column (the default)
      :landing  no sidebar, full width; the page draws its own bands
      :article  no sidebar; the text column centred in the window
  %>
  <% @frame ||= :docs %>
  <% @menu_path ||= '/learn/menu' if @frame == :docs && @menu_html.nil? %>

  <body>

    <div class="screen" up-main="cover">

      <div class="guide">

        <div class="guide--head" up-fixed="top">

          <%# One bar in one color, arranged like react.dev's: the brand on the left, the
              search in the middle, every section on the right. Below $bp-sidebar the
              sections and the version switch move into the drawer behind the burger;
              the search stays, as an icon. %>
          <div class="viewport">

            <div class="guide--brand">
              <a class="logo" href="/">
                <%= image_tag 'unpoly_logo.svg', class: 'logo--pixels', alt: 'Unpoly' %>
              </a>

              <a href="/version_choice" class="version-nav" up-layer="new popup" up-target=".choice">
                <%= guide.short_version %> <i class="fa fa-angle-down"></i>
              </a>
            </div>

            <div class="guide--search">
              <%= partial 'search_pill' %>
            </div>

            <div class="guide--top-nav">
              <%= partial 'top_nav' %>
            </div>

          </div>

        </div>

        <div class="guide--torso <%= { landing: '-full-width', article: '-article' }[@frame] %>" up-main="root">

          <div class="viewport">

            <% if @frame == :docs %>
              <div class="guide--left">

                <%# The menu loads after the page and is kept while the next page renders the
                    same placeholder (one section), so it keeps its expansion and scroll
                    position. up-keep sits on the wrapper because the placeholder replaces
                    itself; [up-on-keep] refuses to keep a wrapper whose menu never loaded. %>
                <div class="guide--menu" up-viewport up-keep="same-html" up-on-keep="if (!this.querySelector('.menu')) event.preventDefault()">
                  <% if @menu_html %>
                    <%= @menu_html %>
                  <% else %>
                    <a href="<%= @menu_path %>" up-defer up-id="menu" class="guide--menu-placeholder">Menu</a>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="guide--main">

              <div class="guide--content" up-main="modal" <%= search_body_attrs %>>
                <%= search_meta_tags %>
                <%= yield %>
              </div>

              <%# One footer on every page, landing included (the mock's centered line). %>
              <footer class="guide--footer">
                Made by <a href="https://triskweline.de/" class="hyperlink -gray">Henning Koch</a>
                &middot; <a href="/imprint" class="hyperlink -gray">Imprint</a>
                &middot; <a href="/privacy" class="hyperlink -gray">Privacy policy</a>
              </footer>

            </div>

          </div>

        </div>

      </div>

     </div>

    <%# The search dialog's markup, opened as a modal overlay (search_dialog.js). %>
    <%= partial 'search_dialog' %>

    <%= partial 'layouts/foot' %>

  </body>

</html>
