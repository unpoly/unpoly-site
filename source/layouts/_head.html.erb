<head>
  <%= partial 'layouts/meta' %>
  <%# Enables WebMCP (webmcp.js) in Chrome's origin trial for https://unpoly.com. The token
      is per Chrome milestone: this one is for Chrome 162 and expires on 2027-03-30. Renew it
      in Chrome's origin-trial console with the next Chrome release. %>
  <meta http-equiv="origin-trial" content="AnnBDPgWwhd/+SgXXmezJTK7A78NKa4S/saPZ3tpDMRRfGAcuKB5TRi4ThrZm+UUMCbK2UiN5V9LJMgr4FshUwkAAABKeyJvcmlnaW4iOiJodHRwczovL3VucG9seS5jb206NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTgwNjM2NDgwMH0=">
  <title><%= window_title %></title>
  <%# The one URL search engines should list this page under, or a request to not list it
      at all (indexable? in config.rb). Unpoly swaps both on navigation. %>
  <% if indexable? %>
    <% head_link(rel: 'canonical', href: canonical_url) %>
    <%# What search engines and link unfurlers show for the page: its title, description
        and preview image (og_image). No og:type: the default (website) fits. An unfurl
        on X only grows to a large image with twitter:card; for everything else, X reads
        the og:* tags. Unpoly swaps all of these on navigation
        (up.history.config.metaTagSelectors). %>
    <% description = page_description(content) %>
    <% if description %>
      <%= tag(:meta, name: 'description', content: description) %>
      <%= tag(:meta, property: 'og:description', content: description) %>
    <% end %>
    <%= tag(:meta, property: 'og:title', content: window_title) %>
    <%= tag(:meta, property: 'og:url', content: canonical_url) %>
    <% if (image = og_image(description)) %>
      <%= tag(:meta, property: 'og:image', content: image.url) %>
      <%= tag(:meta, property: 'og:image:width', content: Unpoly::Site::OgImage::WIDTH) %>
      <%= tag(:meta, property: 'og:image:height', content: Unpoly::Site::OgImage::HEIGHT) %>
      <%= tag(:meta, property: 'og:image:alt', content: image.alt) %>
      <%= tag(:meta, name: 'twitter:card', content: 'summary_large_image') %>
    <% end %>
  <% else %>
    <meta name="robots" content="noindex, follow">
  <% end %>
  <%= head_links_html %>
  <%= stylesheet_link_tag 'guide/all' %>
</head>
