<%#
  The site's search, opened from every page as a modal overlay (up.layer.open). This
  template only holds its markup: search_dialog.js opens a modal with this content when
  the header's search trigger is clicked or "/" is pressed, and the framework provides
  the rest of a dialog (backdrop, focus trap, Escape, scroll lock, stacking).

  The full-text index is fetched on the first open, so a reader who never searches
  pays nothing for it. Without JavaScript nothing
  opens and the header's trigger stays what it is in the markup: a link to the reference.
%>
<template class="search-dialog-template" data-pagefind-ignore>
  <div class="search-dialog--head">
    <%= icon('search', class: 'search-dialog--icon') %>
    <input type="text"
           class="search-dialog--input"
           placeholder="Search docs…"
           aria-label="Search docs"
           role="combobox"
           aria-expanded="false"
           aria-controls="search-dialog-results"
           aria-autocomplete="list"
           autocomplete="off"
           spellcheck="false"
           autofocus>
  </div>

  <%# Only options may live in the listbox, so the messages below sit outside it. %>
  <div class="search-dialog--results" id="search-dialog-results" role="listbox" aria-label="Search results"></div>

  <%# A message instead of results: nothing found, or search unavailable. %>
  <div class="search-dialog--notice"></div>

  <%# Shown until the reader types. %>
  <p class="search-dialog--tip">
    <span class="search-dialog--tip-label">Tip</span>
    Your coding agent can search these docs locally with the <a href="<%= doc_path('skill') %>" up-layer="root">Unpoly agent skill</a>
  </p>

  <%# The glyph on a result's badge, by badge (config.rb, search_badge): the glyphs of
      the kind tiles in a feature list, a book for a guide page, a package for a module
      or class (Icon::SVG). search_dialog.js copies them from here. %>
  <%
    badge_glyphs = Unpoly::Site::Icon::SVG.each_key.grep(/\Akind-/).to_h { |name| [name.delete_prefix('kind-'), name] }
    badge_glyphs.merge!('learn' => 'book', 'module' => 'package', 'class' => 'package', 'api' => 'package')
  %>
  <div class="search-dialog--glyphs" hidden>
    <% badge_glyphs.each do |badge, name| %>
      <span data-glyph="<%= badge %>"><%= icon(name) %></span>
    <% end %>
  </div>

  <%# What screen readers hear after a search: "3 results for overlays". %>
  <div class="search-dialog--status" role="status" aria-live="polite"></div>

  <div class="search-dialog--foot">
    <span class="search-dialog--hint"><kbd>↑↓</kbd> navigate</span>
    <span class="search-dialog--hint"><kbd>↵</kbd> open</span>
    <span class="search-dialog--hint"><kbd>esc</kbd> close</span>
  </div>
</template>
