<%#
  One node of the menu tree. Nodes come from the TOC manifest (topics and groups) and
  from parsed documentation (modules, pages, features) — this template only asks them
  what every node can answer.
%>
<%# overview: whether this node is its chapter's overview (Topic#menu_overview). %>
<div class="node <%= (node.menu_modifiers + (defined?(overview) && overview ? ['overview'] : [])).map { |modifier| "-#{modifier}" }.join(' ') %>">
  <% if node.menu_path %>
    <% node_link node.menu_path do %>
      <span class="node--title"><%= breakable_signature(node.menu_title) %></span>

      <% node_meta do %>
        <% if node.menu_experimental? %>
          <%= icon('flask', label: 'Experimental', class: 'node--visibility-icon') %>
        <% end %>

        <% node.menu_tags.each do |tag| %>
          <span class="node--tag"><%= tag %></span>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <span class="node--self">
      <span class="node--title"><%= breakable_signature(node.menu_title) %></span>
    </span>
  <% end %>

  <% if node.try(:menu_overview) %>
    <%= partial 'nodes/node', locals: { node: node.menu_overview, overview: true } %>
  <% end %>

  <% node.menu_children.each do |child| %>
    <%= partial 'nodes/node', locals: { node: child } %>
  <% end %>
</div>
