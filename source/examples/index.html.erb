<!doctype html>
<html>

  <% example.reload if development? %>

  <%= partial 'layouts/head' %>

  <body>
    <div class="screen" up-main="cover">

      <div class="example">

        <div class="example--info">

          <div class="example--back">
            <a href="/" up-dismiss class="action">Back</a>
          </div>
          <div class="example--title"><%= example.title %></div>

          <% if example.explanation.present? %>
            <div class="example--explanation prose">
              <%= example.highlight markdown(example.explanation) %>
            </div>
          <% end %>

          <% (example.pages + example.javascripts).each do |asset| %>
            <div class="example--file">
              <div class="example--filename"><%= asset.name %></div>
              <pre class="example--code"><code><%= example.highlight(h asset.text) %></code></pre>
            </div>
          <% end %>
        </div>
        <iframe class="example--demo" src="<%= example.demo_path %>"></iframe>
      </div>
    </div>

    <%= partial 'layouts/foot' %>

  </body>

</html>
